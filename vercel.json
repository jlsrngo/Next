{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "buildCommand": "prisma generate && vite build",
  "rewrites": [
    {
      "source": "/api/experiences/:id",
      "destination": "/api/experiences?id=:id"
    },
    {
      "source": "/api/education/:id",
      "destination": "/api/education?id=:id"
    },
    {
      "source": "/api/achievements/:id",
      "destination": "/api/achievements?id=:id"
    },
    {
      "source": "/api/projects/:id",
      "destination": "/api/projects?id=:id"
    },
    {
      "source": "/api/social-links/:id",
      "destination": "/api/social-links?id=:id"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
